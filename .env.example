# ============================================================
# Voice latency lab — configuration
# Copy to .env and fill in. All values are read via python-dotenv.
# ============================================================

# --- LLM backend selection: groq | gemini | gemma_local ---
LLM_BACKEND=groq

# --- Groq (used for BOTH STT and the groq LLM backend) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# --- Local Gemma via Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b-instruct-q4_0

# --- TTS ---
# piper = local neural TTS (needs PIPER_MODEL, no API key)
# null  = returns silence (use for LLM-only latency measurements)
TTS_BACKEND=piper
PIPER_MODEL=C:\path\to\en_US-lessac-medium.onnx

# --- Voice pipeline tuning ---
SILENCE_THRESHOLD=300   # RMS above this counts as speech
SILENCE_MS=700          # pause length that ends a turn
MAX_TURN_MS=15000       # hard cap on one turn's audio

# --- Metrics ---
METRICS_CSV=metrics.csv

# --- Optional: override the public wss:// base URL emitted in TwiML ---
# (Only needed if your reverse proxy does not forward the Host header.)
# PUBLIC_BASE_URL=wss://your-ngrok-url.ngrok-free.app

# --- Server ---
PORT=5000

# --- Twilio (outbound test calls via make_test_call.py) ---
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/voice